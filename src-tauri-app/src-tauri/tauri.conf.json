{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickInput",
  "version": "0.10.0",
  "identifier": "com.quickinput.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "QuickInput",
        "width": 300,
        "height": 400,
        "minWidth": 200,
        "minHeight": 200,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "QuickInput 设置",
        "url": "/settings",
        "width": 520,
        "height": 480,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
