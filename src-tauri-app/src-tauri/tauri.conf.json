{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickInput",
  "version": "0.13.3",
  "identifier": "com.quickinput.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "QuickInput",
        "width": 300,
        "height": 400,
        "minWidth": 200,
        "minHeight": 200,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "QuickInput 设置",
        "url": "/settings",
        "width": 520,
        "height": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": false
      },
      {
        "label": "floater",
        "title": "QuickInput 浮层",
        "url": "/floater",
        "x": 0,
        "y": 0,
        "width": 1,
        "height": 1,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "app-windows-default",
          "description": "为所有应用窗口授予 Tauri 默认能力（含事件监听/触发、窗口显隐/拖拽/尺寸位置，浮层窗口事件通信必需）",
          "windows": ["overlay", "settings", "floater"],
          "permissions": [
            "core:default",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-outer-position",
            "core:window:allow-outer-size",
            "core:window:allow-inner-size",
            "core:window:allow-scale-factor",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
